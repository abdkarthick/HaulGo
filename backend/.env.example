# Copy this file to ".env" (same folder) and fill in what you need. Restart the backend after changes.
# Sign in with Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=
# AI assistant (free key from Google AI Studio)
GEMINI_API_KEY=
# Email for "Forgot password" codes. Hostinger: smtp.hostinger.com + 465. Gmail: smtp.gmail.com + 587 + app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
